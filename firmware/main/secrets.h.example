#pragma once

// Copy this file to secrets.h and fill in your own values. Never commit secrets.h.
#define WIFI_SSID "your-wifi-name"
#define WIFI_PASSWORD "your-wifi-password"
#define DEVICE_URL "https://remote-boot-device.YOUR-SUBDOMAIN.workers.dev"
#define DEVICE_TOKEN "paste-the-same-random-token-stored-in-the-device-worker"

// Relay normally-open contacts must be wired across the motherboard power-button pins.
// Most relay boards are active-low; check your module before powering the ESP32.
#define RELAY_GPIO 26
#define RELAY_ACTIVE_LEVEL 0
#define RELAY_PULSE_MS 500
